# Copy this file to .env and fill it in. Never commit .env.

# Your OpenRouter key (https://openrouter.ai/settings/keys). Only this server ever sees it.
OPENROUTER_API_KEY=

# Where this server listens and the address the apps and Stripe use to reach it.
PORT=8787
PUBLIC_URL=http://127.0.0.1:8787

# Price you charge = OpenRouter cost × MARKUP. 1.25 = 25% margin on usage.
MARKUP=1.25
# 1 credit = this many US dollars of sale value (0.001 → 1,000 credits = US$ 1).
CREDIT_USD=0.001
# Free credits for a new account (0 to turn off).
TRIAL_CREDITS=300

# Admin token for /admin routes and scripts (any long random text).
ADMIN_TOKEN=

# Stripe (https://dashboard.stripe.com/test/apikeys). Leave empty to run without payments.
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:8787/stripe/webhook` or the webhook page.
STRIPE_WEBHOOK_SECRET=
# Price ids you create in Stripe (see README). Plans and packs are in plans.json.
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_PACK_S=
STRIPE_PRICE_PACK_L=

# Optional: a comma-separated list of chat models to show (OpenRouter ids). Empty = curated automatic list.
CHAT_MODELS=
