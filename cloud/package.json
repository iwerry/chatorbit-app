{
  "name": "orbi-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "Orbi Cloud: accounts, subscriptions, credits and the OpenRouter gateway used by the Orbi apps.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning src/main.ts",
    "grant": "node --env-file-if-exists=.env --experimental-strip-types --disable-warning=ExperimentalWarning scripts/grant.ts",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts"
  }
}
